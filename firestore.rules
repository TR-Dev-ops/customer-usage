rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null ? request.auth.token.email : '';
    }
    function isAdmin() {
      return email() == 'admin@customer-usage.local';
    }
    // ลูกค้าเห็นเฉพาะแถวของตัวเอง
    function isCustomer(c) {
      return (c == 'A' && email() == 'a@customer-usage.local')
          || (c == 'B' && email() == 'b@customer-usage.local');
    }

    function validRecord(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['customer', 'month', 'trips', 'weightTon', 'revenue', 'updatedAt'])
        && d.keys().hasOnly(['customer', 'month', 'trips', 'weightTon', 'revenue', 'updatedAt'])
        && d.customer in ['A', 'B']
        && d.month is string && d.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && id == d.customer + '_' + d.month
        && d.trips is int && d.trips >= 0
        && d.weightTon is number && d.weightTon >= 0
        && d.revenue is int && d.revenue >= 0
        && d.updatedAt is string;
    }

    match /records/{id} {
      allow read: if isAdmin() || isCustomer(resource.data.customer);
      allow create, update: if isAdmin() && validRecord(id);
      allow delete: if isAdmin();
    }
  }
}
